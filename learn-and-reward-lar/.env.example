# Shared environment for local development / Docker Compose.
# Copy to .env and adjust. NEVER commit real secrets.

# --- Database (used by services/api) ---
# Local dev without Docker (SQLite):
DATABASE_URL=sqlite:///./dev.db
# Full stack via Docker Compose (PostgreSQL + pgvector):
# DATABASE_URL=postgresql+psycopg://lar:lar_secret@db:5432/lar

# --- Auth (placeholder core module by Developer C; shared JWT secret) ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- AI ---
# DeepSeek API key for the ai_chat module (Developer B)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Cross-module adapters (until Developer A / C modules are merged) ---
# coin: stub (default) | internal  (internal = Developer C's CoinService)
COIN_MODE=stub
# rag: stub (default) | internal  (internal = Developer A's POST /api/v1/rag/search)
RAG_MODE=stub
RAG_SEARCH_URL=

# --- App ---
APP_ENV=local
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000

# --- Docker Compose only ---
POSTGRES_USER=lar
POSTGRES_PASSWORD=lar_secret
POSTGRES_DB=lar
