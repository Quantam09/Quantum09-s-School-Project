# Local development environment for the API service.
# Copy to .env and fill in real values. NEVER commit .env.

# Local dev without Docker (SQLite). For the full stack use the postgres URL from
# infra/docker-compose.yml instead.
DATABASE_URL=sqlite:///./dev.db

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# DeepSeek API key for the ai_chat module (Developer B scope)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Cross-module adapters until Developer A (rag) and Developer C (coin) modules are merged
COIN_MODE=stub
RAG_MODE=stub
RAG_SEARCH_URL=

APP_ENV=local
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000
